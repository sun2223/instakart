# Leave blank to use persistent, local JSON-backed demo mode. No MongoDB installation required.
MONGO_URI=
# Get a key at https://console.groq.com/keys (keep it server-side only).
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
PORT=3001
FRONTEND_URL=http://localhost:5173
# REQUIRED for deployment; use a long randomly generated secret. Development uses an ephemeral secret if absent.
JWT_SECRET=
NODE_ENV=development
# Enables shortened demo-only courier status transitions. Never represents an actual delivery service.
SIMULATE_DELIVERY=true
